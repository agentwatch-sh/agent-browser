{
  "contract": "C10, docs/protocol.md. The receiver (stage 2), the relay (stage 3) and the daemon (stage 4) check their code against these vectors. Every value is a sample. Since board ab-v16.30 the vectors hold the per-scope rules (the scope arg of tabs.create and windows.create, the kind scope, bridge.tabScope, the allowlist line with lists and scopes): the receiver meets them from part 1a (board ab-v16.31) on, the relay from part 2 (board ab-v16.35) on. Since board ab-v16.41 they also hold the orphan-tabs rules (the op bridge.tabScopes, the error no list for this scope, the window rule of the removal queue, the receiver's close of tabs.remove by Target.closeTarget, and TOMBSTONE_MS, RESTORE_MAX_MS and REMOVAL_WAIT_MS), which the receiver meets from part 1a on and the relay from part 2 on.",
  "constants": {
    "BRIDGE_VERSION": 1,
    "WAIT_DEFAULT_MS": 30000,
    "WAIT_MAX_MS": 600000,
    "WAIT_SLACK_MS": 2000,
    "MAX_IN_FLIGHT_PER_TAB": 64,
    "MAX_BYTES_IN_FLIGHT": 268435456,
    "MAX_REQUEST": 134217728,
    "MAX_TO_DAEMON": 8388608,
    "PART_BYTES": 700000,
    "MAX_RESULT": 134217728,
    "RESULT_PART_BYTES": 4194304,
    "HOLD_MAX_MS": 5000,
    "TOMBSTONE_MS": 10000,
    "RESTORE_MAX_MS": 2000,
    "REMOVAL_WAIT_MS": 2000
  },
  "allowlist": ["a.example"],
  "allowlistNote": "The union of the lists of the receiver's last applied set_scopes (C4, C5): contentDetails is checked against it (any list, C10).",
  "setScopes": {"lists": {"md": ["a.example"]}, "scopes": {"my-repo": "md", "md-gone": null}, "default": null},
  "setScopesNote": "The receiver's last applied set_scopes of the samples (C4, C5): scope my-repo has list md, scope md-gone has no list (a session that ended), and so has every scope that it does not name. allowlist is the union of its lists.",
  "scope": "my-repo",
  "scopeNote": "The scope of the samples: a scope of C11, the second arg of tabs.create and windows.create.",
  "kinds": {
    "id": "an integer of 0 or more: a tab, window or download id",
    "object": "a JSON object",
    "string": "a string that is not empty",
    "method": "a CDP method of debugger.sendCommand: a string that is not empty; of the Target domain only the methods of targetMethods (review-22 B1: no Target.createTarget, which can open Chrome's New Tab page)",
    "boolean": "true or false",
    "target": "{\"tabId\": <id>} or {\"tabId\": <id>, \"sessionId\": \"<child session>\"}, with no other key; tabId is 0 or more",
    "contentType": "one of contentTypes",
    "scope": "a string that matches C11's scope pattern ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$",
    "newTab": "an object with url (about:blank) and at most active (boolean), windowId and index (ids)",
    "tabUpdate": "exactly {\"active\": <boolean>}",
    "newWindow": "an object with url (about:blank, a string) and at most focused (boolean), left, top, width, height (integers) and state; no tabId",
    "windowUpdate": "an object with at least one of left, top, width, height, state and focused, and no other key",
    "contentDetails": "exactly primaryPattern (<scheme>://<host>/* or <scheme>://<host>:<port>/*, scheme http, https or *, host covered by the allowlist, with or without *.) and setting (allow or block)"
  },
  "newUrl": "about:blank: a new tab or window makes no request before its scope rule is in force",
  "contentTypes": ["location", "notifications", "camera", "microphone", "clipboard", "automaticDownloads"],
  "targetMethodsNote": "The Target methods that the relay sends to Chrome through debugger.sendCommand (C11, where each call goes): the kind method allows these and no other Target method.",
  "targetMethods": ["Target.setAutoAttach", "Target.getTargetInfo", "Target.detachFromTarget"],
  "ops": [
    {"op": "debugger.attach", "args": ["tabId"], "kinds": ["id"], "required": 1, "result": "`{\"already\": <bool>}`", "defaultWait": "WAIT_DEFAULT_MS"},
    {"op": "debugger.detach", "args": ["tabId"], "kinds": ["id"], "required": 1, "result": "`null`", "defaultWait": "WAIT_DEFAULT_MS"},
    {"op": "debugger.sendCommand", "args": ["target", "method", "params?"], "kinds": ["target", "method", "object"], "required": 2, "result": "the CDP result", "defaultWait": "WAIT_MAX_MS"},
    {"op": "debugger.getTargets", "args": [], "kinds": [], "required": 0, "result": "`[TargetInfo]`", "defaultWait": "WAIT_DEFAULT_MS"},
    {"op": "tabs.create", "args": ["createProperties", "scope"], "kinds": ["newTab", "scope"], "required": 2, "result": "`Tab`", "defaultWait": "WAIT_DEFAULT_MS"},
    {"op": "tabs.get", "args": ["tabId"], "kinds": ["id"], "required": 1, "result": "`Tab`", "defaultWait": "WAIT_DEFAULT_MS"},
    {"op": "tabs.query", "args": ["queryInfo"], "kinds": ["object"], "required": 1, "result": "`[Tab]`", "defaultWait": "WAIT_DEFAULT_MS"},
    {"op": "tabs.update", "args": ["tabId", "updateProperties"], "kinds": ["id", "tabUpdate"], "required": 2, "result": "`Tab`", "defaultWait": "WAIT_DEFAULT_MS"},
    {"op": "tabs.remove", "args": ["tabId"], "kinds": ["id"], "required": 1, "result": "`null`", "defaultWait": "WAIT_DEFAULT_MS"},
    {"op": "windows.get", "args": ["windowId", "queryOptions?"], "kinds": ["id", "object"], "required": 1, "result": "`Window`", "defaultWait": "WAIT_DEFAULT_MS"},
    {"op": "windows.create", "args": ["createData", "scope"], "kinds": ["newWindow", "scope"], "required": 2, "result": "`Window`", "defaultWait": "WAIT_DEFAULT_MS"},
    {"op": "windows.update", "args": ["windowId", "updateInfo"], "kinds": ["id", "windowUpdate"], "required": 2, "result": "`Window`", "defaultWait": "WAIT_DEFAULT_MS"},
    {"op": "downloads.search", "args": ["query"], "kinds": ["object"], "required": 1, "result": "`[DownloadItem]`", "defaultWait": "WAIT_DEFAULT_MS"},
    {"op": "downloads.cancel", "args": ["downloadId"], "kinds": ["id"], "required": 1, "result": "`null`", "defaultWait": "WAIT_DEFAULT_MS"},
    {"op": "contentSettings.set", "args": ["type", "details"], "kinds": ["contentType", "contentDetails"], "required": 2, "result": "`null`", "defaultWait": "WAIT_DEFAULT_MS"},
    {"op": "contentSettings.clear", "args": ["type"], "kinds": ["contentType"], "required": 1, "result": "`null`", "defaultWait": "WAIT_DEFAULT_MS"},
    {"op": "bridge.info", "args": [], "kinds": [], "required": 0, "result": "an object (below)", "defaultWait": "WAIT_DEFAULT_MS"},
    {"op": "bridge.attachNew", "args": ["on"], "kinds": ["boolean"], "required": 1, "result": "`null`", "defaultWait": "WAIT_DEFAULT_MS"},
    {"op": "bridge.release", "args": ["tabId"], "kinds": ["id"], "required": 1, "result": "`null`", "defaultWait": "WAIT_DEFAULT_MS"},
    {"op": "bridge.tabScopes", "args": [], "kinds": [], "required": 0, "result": "`[{\"tabId\":<id>,\"scope\":\"<scope>\"}]`", "defaultWait": "WAIT_DEFAULT_MS"}
  ],
