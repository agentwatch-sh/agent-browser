{
  "name": "agent-browser",
  "version": "0.2.9",
  "private": true,
  "description": "Agent browser for agentwatch and vedlo: Chrome over a local proxy, allowlisted hosts only",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "bin": {
    "agent-browser": "bin/agent-browser.js"
  },
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "loader.js",
    "bin/",
    "src/",
    "python/agent_browser/",
    "README.md"
  ],
  "scripts": {
    "test": "npm run test:node && npm run test:python",
    "test:node": "node --test --test-concurrency=1 'test/**/*.test.ts'",
    "test:python": "python3 -m unittest discover -s python/tests -t python",
    "test:live": "node test/live/sheets.ts",
    "test:live:agent": "node test/live/agent-mode/run.ts"
  },
  "dependencies": {
    "@playwright/mcp": "0.0.83",
    "ghost-cursor": "1.4.2",
    "playwright": "1.64.0-alpha-1790635538000",
    "playwright-core": "1.64.0-alpha-1790635538000",
    "ws": "8.21.0"
  }
}
