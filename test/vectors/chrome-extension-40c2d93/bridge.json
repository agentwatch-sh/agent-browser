    {"note": "A command of a child session (a frame or a worker); a missing params goes to Chrome as {}.", "req": {"t": "req", "id": "5f3a9c01-3", "op": "debugger.sendCommand", "args": [{"tabId": 7, "sessionId": "A1B2C3"}, "Runtime.enable"]}, "chrome": ["debugger.sendCommand", [{"tabId": 7, "sessionId": "A1B2C3"}, "Runtime.enable", {}]], "res": {"t": "res", "ch": "bridge", "id": "5f3a9c01-3", "ok": true, "data": {}}},
